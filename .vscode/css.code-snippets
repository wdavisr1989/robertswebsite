{
	"Flexbox Container": {
		"prefix": "flex",
		"body": [
			"display: flex;",
			"${1|flex-direction: row;,flex-direction: column;,|}",
			"${2|justify-content: center;,justify-content: space-between;,justify-content: flex-start;,justify-content: flex-end;,|}",
			"${3|align-items: center;,align-items: flex-start;,align-items: flex-end;,align-items: stretch;,|}",
			"gap: ${4:1rem};"
		],
		"description": "Flexbox container with common properties"
	},
	"CSS Grid Container": {
		"prefix": "grid",
		"body": [
			"display: grid;",
			"grid-template-columns: ${1:repeat(auto-fit, minmax(250px, 1fr))};",
			"gap: ${2:2rem};"
		],
		"description": "CSS Grid container"
	},
	"Media Query": {
		"prefix": "media",
		"body": [
			"@media screen and (${1|max-width,min-width|}: ${2:768px}) {",
			"\t${3:/* Styles */}",
			"}"
		],
		"description": "Media query breakpoint"
	},
	"CSS Custom Property": {
		"prefix": "var",
		"body": [
			"--${1:property-name}: ${2:value};"
		],
		"description": "CSS custom property definition"
	},
	"Use CSS Variable": {
		"prefix": "usevar",
		"body": [
			"var(--${1:property-name})"
		],
		"description": "Use CSS custom property"
	},
	"Center Absolute": {
		"prefix": "center",
		"body": [
			"position: absolute;",
			"top: 50%;",
			"left: 50%;",
			"transform: translate(-50%, -50%);"
		],
		"description": "Center element absolutely"
	},
	"Transition": {
		"prefix": "trans",
		"body": [
			"transition: ${1:all} ${2:0.3s} ${3:ease};"
		],
		"description": "CSS transition"
	},
	"Box Shadow": {
		"prefix": "shadow",
		"body": [
			"box-shadow: ${1:0 2px 8px} rgba(0, 0, 0, ${2:0.1});"
		],
		"description": "Box shadow"
	},
	"Gradient Background": {
		"prefix": "gradient",
		"body": [
			"background: linear-gradient(${1:135deg}, ${2:var(--primary)} 0%, ${3:var(--accent)} 100%);"
		],
		"description": "Linear gradient background"
	},
	"Hover Effect": {
		"prefix": "hover",
		"body": [
			"&:hover {",
			"\t${1:transform: translateY(-2px);",
			"\tbox-shadow: 0 4px 12px rgba(0, 0, 0, 0.15);}",
			"}"
		],
		"description": "Hover effect"
	},
	"Responsive Image": {
		"prefix": "imgres",
		"body": [
			"width: 100%;",
			"height: auto;",
			"object-fit: cover;",
			"display: block;"
		],
		"description": "Responsive image styles"
	},
	"Sticky Header": {
		"prefix": "sticky",
		"body": [
			"position: sticky;",
			"top: 0;",
			"z-index: ${1:100};",
			"background: ${2:white};",
			"box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);"
		],
		"description": "Sticky header styles"
	}
}
